@page "/{id}/{v1}/{v2}/file"
@using NuGetDiff.Core.Decompilation
@using NuGetDiff.Core.Diffing
@using NuGetDiff.Core.Models
@using NuGetDiff.Core.Packages
@using NuGetDiff.Web.Components
@using NuGetDiff.Web.Services
@using Microsoft.JSInterop
@inherits CancellablePageBase
@inject PackageResolver Resolver
@inject BusyState Busy
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@PageTitleText() — @Id @V1 → @V2</PageTitle>

<nav class="breadcrumb">
    <a href="/">Home</a> /
    <a href="/@Uri.EscapeDataString(Id)">@Id</a> /
    <a href="/@Uri.EscapeDataString(Id)/@Uri.EscapeDataString(V1)/@Uri.EscapeDataString(V2)">@V1 → @V2</a> /
    <strong>@PageTitleText()</strong>
</nav>

<div class="file-layout">
    <aside class="file-sidebar">
        <h2 class="sidebar-title">Changed files</h2>
        @if (_tree is not null)
        {
            <FileTree Node="_tree" OnFileClick="OnFileClick"
                      SelectedPath="@Path" SelectedType="@Type" />
        }
        else if (_error is not null)
        {
            <p class="muted">No tree available.</p>
        }
        else
        {
            <p class="muted">Loading tree…</p>
        }
    </aside>

    <section class="file-content">
        <h1>@PageTitleText()</h1>
        <p class="muted">
            @Path
            @if (!string.IsNullOrEmpty(Type))
            {
                <text> · type <code>@Type</code></text>
            }
            · @Id @V1 → @V2
        </p>

        @if (_error is not null)
        {
            <p class="error">@_error</p>
        }
        else if (_loading)
        {
            <p>Computing diff…</p>
        }
        else if (_diff is null)
        {
            <p class="muted">Nothing to show.</p>
        }
        else
        {
            if (!string.IsNullOrWhiteSpace(_diff.Message))
            {
                <p class="muted">@_diff.Message</p>
            }
            switch (_diff.Kind)
            {
                case FileDiffKind.Text:
                case FileDiffKind.Assembly:
                    if (_diff.Text is not null)
                    {
                        <DiffView Diff="_diff.Text" Language="@_language" />
                    }
                    else
                    {
                        <p class="muted">No textual diff available.</p>
                    }
                    break;
                case FileDiffKind.Binary:
                    <dl class="meta-grid">
                        <dt>Old size</dt><dd>@(_diff.OldLength?.ToString() ?? "—") bytes</dd>
                        <dt>New size</dt><dd>@(_diff.NewLength?.ToString() ?? "—") bytes</dd>
                        <dt>Old SHA256</dt><dd><code>@(_diff.OldHash ?? "—")</code></dd>
                        <dt>New SHA256</dt><dd><code>@(_diff.NewHash ?? "—")</code></dd>
                    </dl>
                    break;
                default:
                    <p class="muted">Unsupported file kind.</p>
                    break;
            }
        }
    </section>
</div>

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    [Parameter] public string V1 { get; set; } = string.Empty;
    [Parameter] public string V2 { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "path")] public string Path { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "type")] public string Type { get; set; } = string.Empty;

    private FileDiff? _diff;
    private FileTreeNode? _tree;
    private string? _error;
    private bool _loading = true;
    private string? _language;
    private bool _shouldHighlight;

    // Skip syntax highlighting for very large diffs to keep the UI responsive:
    // Prism would re-tokenise tens of thousands of <code> nodes synchronously.
    private const int MaxHighlightRows = 5000;

    // Cache the tree-diff per (id, v1, v2) so re-navigating between files in the
    // same comparison doesn't redownload and rediff the whole pair every time.
    private string _treeKey = string.Empty;

    private string PageTitleText()
    {
        if (!string.IsNullOrEmpty(Type))
        {
            var dot = Type.LastIndexOf('.');
            return dot >= 0 ? Type[(dot + 1)..] : Type;
        }
        return string.IsNullOrEmpty(Path) ? Id : System.IO.Path.GetFileName(Path);
    }

    protected override async Task OnParametersSetAsync()
    {
        var ct = BeginLoad();
        var key = $"{Id}|{V1}|{V2}";
        var keyChanged = !string.Equals(_treeKey, key, StringComparison.OrdinalIgnoreCase);
        if (keyChanged)
        {
            _tree = null;
        }
        _diff = null;
        _error = null;
        _loading = true;
        // For per-type diffs the language is always C# regardless of file extension.
        _language = !string.IsNullOrEmpty(Type) ? "csharp" : LanguageDetector.FromPath(Path);
        _shouldHighlight = false;
        StateHasChanged();
        if (string.IsNullOrEmpty(Path))
        {
            _error = "No file path provided.";
            _loading = false;
            return;
        }

        using var _ = Busy.Begin($"Diffing {Path}…");
        try
        {
            await using var s1 = await Resolver.OpenOnlineAsync(Id, V1, ct);
            if (ct.IsCancellationRequested) return;
            await using var s2 = await Resolver.OpenOnlineAsync(Id, V2, ct);
            if (ct.IsCancellationRequested) return;
            if (s1 is null) { _error = $"Could not find {Id} {V1}."; _loading = false; return; }
            if (s2 is null) { _error = $"Could not find {Id} {V2}."; _loading = false; return; }

            using var oldR = new PackageReader(s1);
            using var newR = new PackageReader(s2);

            if (keyChanged || _tree is null)
            {
                Busy.Update("Computing tree diff…");
                await Task.Yield();
                if (ct.IsCancellationRequested) return;
                var treeDiff = new Differ().DiffTree(oldR, newR);
                if (ct.IsCancellationRequested) return;
                var changedOnly = treeDiff.Changes
                    .Where(c => c.Kind != FileChangeKind.Unchanged)
                    .ToList();
                var decomp = new Decompiler();
                Func<FileEntry, IReadOnlyList<TypeSummary>> typesForOld = entry =>
                {
                    var r = decomp.ListTypes(oldR, entry.Path);
                    return r.IsOk ? r.Ok! : Array.Empty<TypeSummary>();
                };
                Func<FileEntry, IReadOnlyList<TypeSummary>> typesForNew = entry =>
                {
                    var r = decomp.ListTypes(newR, entry.Path);
                    return r.IsOk ? r.Ok! : Array.Empty<TypeSummary>();
                };
                _tree = FileTreeBuilder.BuildFromChanges(changedOnly, typesForOld, typesForNew);
                _treeKey = key;
                StateHasChanged();
            }

            Busy.Update($"Computing diff for {(string.IsNullOrEmpty(Type) ? Path : Type)}…");
            await Task.Yield();
            if (ct.IsCancellationRequested) return;
            var diff = !string.IsNullOrEmpty(Type)
                ? new Differ().DiffType(oldR, newR, Path, Type)
                : new Differ().DiffFile(oldR, newR, Path);
            if (ct.IsCancellationRequested) return;
            _diff = diff;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            return;
        }
        catch (Exception ex)
        {
            if (ct.IsCancellationRequested) return;
            _error = $"Failed to diff: {ex.Message}";
        }
        finally
        {
            if (!ct.IsCancellationRequested)
            {
                _loading = false;
                _shouldHighlight =
                    _diff?.Text is not null
                    && !string.IsNullOrEmpty(_language)
                    && _diff.Text.Old.Count <= MaxHighlightRows
                    && _diff.Text.New.Count <= MaxHighlightRows;
            }
        }
    }

    // Re-run Prism after EVERY render — Razor may rewrite <code> text content
    // on a re-render that touches DiffView, which would discard Prism's spans.
    // Prism.highlightAllUnder is idempotent: it tokenises from textContent,
    // which yields the same result whether the cell currently shows raw text
    // or already-highlighted spans.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldHighlight)
        {
            try
            {
                await JS.InvokeVoidAsync("nuGetDiff.highlightAll", ".file-content");
            }
            catch (JSException)
            {
                // Prism not loaded or no element to highlight — non-fatal.
            }
            catch (TaskCanceledException)
            {
                // Component disposed mid-call — safe to ignore.
            }
        }
    }

    private void OnFileClick(FileTreeNode node)
    {
        if (node.IsDirectory) return;
        var p = Uri.EscapeDataString(node.FullPath);
        var url = $"/{Uri.EscapeDataString(Id)}/{Uri.EscapeDataString(V1)}/{Uri.EscapeDataString(V2)}/file?path={p}";
        if (!string.IsNullOrEmpty(node.TypeFullName))
        {
            url += $"&type={Uri.EscapeDataString(node.TypeFullName)}";
        }
        Nav.NavigateTo(url);
    }
}
