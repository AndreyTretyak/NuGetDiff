@page "/{id}/{v1}/{v2}/file"
@using NuGetDiff.Core.Decompilation
@using NuGetDiff.Core.Diffing
@using NuGetDiff.Core.Models
@using NuGetDiff.Core.Packages
@using NuGetDiff.Web.Components
@using NuGetDiff.Web.Services
@inherits CancellablePageBase
@inject PackageComparisonService Comparisons
@inject BusyState Busy
@inject NavigationManager Nav

<PageTitle>@PageTitleText() — @Id @V1 → @V2</PageTitle>

<nav class="breadcrumb">
    <a href="/">Home</a> /
    <a href="/@Uri.EscapeDataString(Id)">@Id</a> /
    <a href="/@Uri.EscapeDataString(Id)/@Uri.EscapeDataString(V1)/@Uri.EscapeDataString(V2)">@V1 → @V2</a> /
    <strong>@PageTitleText()</strong>
</nav>

<div class="file-layout">
    <aside class="file-sidebar">
        <h2 class="sidebar-title">Package files</h2>
        <label class="file-filter">
            <input type="checkbox"
                   aria-label="Hide unchanged files"
                   checked="@_hideUnchangedFiles"
                   disabled="@(_treeDiff is null)"
                   @onchange="OnFileFilterChanged" />
            Hide unchanged files
        </label>
        @if (_tree is not null)
        {
            <FileTree Node="_tree" OnFileClick="OnFileClick"
                      OnAssemblyExpand="OnAssemblyExpand"
                      OnAssemblyToggle="OnAssemblyToggle"
                      SelectedPath="@SelectedTreePath" SelectedType="@Type" />
        }
        else if (_error is not null)
        {
            <p class="muted">No tree available.</p>
        }
        else
        {
            <p class="muted">Loading tree…</p>
        }
    </aside>

    <section class="file-content">
        <h1>@PageTitleText()</h1>
        <p class="muted">
            @Path
            @if (!string.IsNullOrEmpty(Type))
            {
                <text> · type <code>@Type</code></text>
            }
            · @Id @V1 → @V2
        </p>

        @if (_error is not null)
        {
            <p class="error">@_error</p>
        }
        else if (_loading)
        {
            <p>Computing diff…</p>
        }
        else if (_diff is null)
        {
            <p class="muted">Nothing to show.</p>
        }
        else
        {
            if (!string.IsNullOrWhiteSpace(_diff.Message))
            {
                <p class="diff-notice" role="status">@_diff.Message</p>
            }
            switch (_diff.Kind)
            {
                case FileDiffKind.Text:
                case FileDiffKind.Assembly:
                    if (_diff.Text is not null)
                    {
                        <DiffView Diff="_diff.Text" Language="@_language" />
                    }
                    else
                    {
                        <p class="muted">No textual diff available.</p>
                    }
                    break;
                case FileDiffKind.Binary:
                    <dl class="meta-grid">
                        <dt>Old size</dt><dd>@(_diff.OldLength?.ToString() ?? "—") bytes</dd>
                        <dt>New size</dt><dd>@(_diff.NewLength?.ToString() ?? "—") bytes</dd>
                        <dt>Old SHA256</dt><dd><code>@(_diff.OldHash ?? "—")</code></dd>
                        <dt>New SHA256</dt><dd><code>@(_diff.NewHash ?? "—")</code></dd>
                    </dl>
                    break;
                default:
                    <p class="muted">Unsupported file kind.</p>
                    break;
            }
        }
    </section>
</div>

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    [Parameter] public string V1 { get; set; } = string.Empty;
    [Parameter] public string V2 { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "path")] public string Path { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "type")] public string Type { get; set; } = string.Empty;

    private FileDiff? _diff;
    private TreeDiff? _treeDiff;
    private FileTreeNode? _tree;
    private string? _error;
    private bool _loading = true;
    private bool _hideUnchangedFiles = true;
    private string? _language;
    private readonly Dictionary<string, IReadOnlyList<TypeChange>> _loadedTypeChanges =
        new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, IReadOnlyList<TypeChange>> _listedTypeChanges =
        new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, long> _loadingTypePaths =
        new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, (long Id, CancellationTokenSource Cts)> _typeLoadTokens =
        new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _expandedTypePaths =
        new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _failedTypeLoads =
        new(StringComparer.OrdinalIgnoreCase);
    private long _nextTypeLoadId;

    // Cache the tree-diff per (id, v1, v2) so re-navigating between files in the
    // same comparison doesn't redownload and rediff the whole pair every time.
    private string _treeKey = string.Empty;

    private string SelectedTreePath => ResolveTreePath(Path);

    private string PageTitleText()
    {
        if (!string.IsNullOrEmpty(Type))
        {
            var dot = Type.LastIndexOf('.');
            return dot >= 0 ? Type[(dot + 1)..] : Type;
        }
        return string.IsNullOrEmpty(Path) ? Id : System.IO.Path.GetFileName(Path);
    }

    protected override async Task OnParametersSetAsync()
    {
        var ct = BeginLoad();
        var key = $"{Id}|{V1}|{V2}";
        var keyChanged = !string.Equals(_treeKey, key, StringComparison.OrdinalIgnoreCase);
        if (keyChanged)
        {
            CancelTypeLoads();
            _tree = null;
            _treeDiff = null;
            _loadedTypeChanges.Clear();
            _listedTypeChanges.Clear();
            _expandedTypePaths.Clear();
            _failedTypeLoads.Clear();
        }
        _diff = null;
        _error = null;
        _loading = true;
        // For per-type diffs the language is always C# regardless of file extension.
        _language = !string.IsNullOrEmpty(Type) ? "csharp" : LanguageDetector.FromPath(Path);
        StateHasChanged();
        if (string.IsNullOrEmpty(Path))
        {
            _error = "No file path provided.";
            _loading = false;
            return;
        }

        using var busyScope = Busy.Begin($"Diffing {Path}…");
        try
        {
            var result = await Comparisons.CompareFileAsync(
                Id,
                V1,
                V2,
                Path,
                Type,
                Busy.Update,
                ct);
            if (ct.IsCancellationRequested) return;
            if (!result.IsSuccess)
            {
                _error = result.Error;
                return;
            }

            _treeDiff = result.TreeDiff;
            if (keyChanged || _tree is null)
            {
                RebuildTree();
                _treeKey = key;
                StateHasChanged();
            }

            _diff = result.FileDiff;
            _loading = false;
            busyScope.Dispose();
            StateHasChanged();
            await EnsureSelectedAssemblyTypesAsync(ct);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            return;
        }
        catch (Exception ex)
        {
            if (ct.IsCancellationRequested) return;
            _error = $"Failed to diff: {ex.Message}";
        }
        finally
        {
            if (!ct.IsCancellationRequested)
            {
                _loading = false;
            }
        }
    }

    private async Task OnFileFilterChanged(ChangeEventArgs args)
    {
        _hideUnchangedFiles = args.Value is bool value && value;
        RebuildTree();
        await EnsureSelectedAssemblyTypesAsync(CurrentCancellationToken);
    }

    private void RebuildTree()
    {
        if (_treeDiff is null)
        {
            _tree = null;
            return;
        }

        var changes = _hideUnchangedFiles
            ? _treeDiff.Changes.Where(ShouldIncludeFile)
            : _treeDiff.Changes;
        _tree = FileTreeBuilder.BuildFromChanges(changes);
        foreach (var (path, typeChanges) in _loadedTypeChanges)
        {
            var assembly = FileTreeBuilder.FindFileNode(_tree, path);
            if (assembly is null)
            {
                continue;
            }
            assembly.IsExpanded = _expandedTypePaths.Contains(path);
            FileTreeBuilder.PopulateAssemblyTypeChanges(
                assembly,
                typeChanges,
                _hideUnchangedFiles);
        }
        foreach (var (path, typeChanges) in _listedTypeChanges)
        {
            if (_loadedTypeChanges.ContainsKey(path))
            {
                continue;
            }
            var assembly = FileTreeBuilder.FindFileNode(_tree, path);
            if (assembly is null)
            {
                continue;
            }
            assembly.IsExpanded = _expandedTypePaths.Contains(path);
            FileTreeBuilder.PopulateAssemblyTypeChanges(
                assembly,
                typeChanges,
                hideUnchanged: false);
            assembly.TypeLoadState = AssemblyTypeLoadState.Analyzing;
        }
        foreach (var path in _loadingTypePaths.Keys)
        {
            var assembly = FileTreeBuilder.FindFileNode(_tree, path);
            if (assembly is not null)
            {
                assembly.IsExpanded = _expandedTypePaths.Contains(path);
                assembly.TypeLoadState = _listedTypeChanges.ContainsKey(path)
                    ? AssemblyTypeLoadState.Analyzing
                    : AssemblyTypeLoadState.Loading;
            }
        }
        foreach (var (path, error) in _failedTypeLoads)
        {
            var assembly = FileTreeBuilder.FindFileNode(_tree, path);
            if (assembly is not null)
            {
                assembly.IsExpanded = _expandedTypePaths.Contains(path);
                assembly.TypeLoadState = AssemblyTypeLoadState.Failed;
                assembly.TypeLoadError = error;
            }
        }

    }

    private bool ShouldIncludeFile(FileChange change)
        => change.Kind != FileChangeKind.Unchanged
           || (_loadedTypeChanges.TryGetValue(change.Path, out var typeChanges)
               && typeChanges.Any(typeChange =>
                   typeChange.Kind != FileChangeKind.Unchanged))
           || _listedTypeChanges.ContainsKey(change.Path)
           || _failedTypeLoads.ContainsKey(change.Path);

    private string ResolveTreePath(string path)
    {
        var change = _treeDiff?.Changes.FirstOrDefault(candidate =>
            string.Equals(candidate.Path, path, StringComparison.OrdinalIgnoreCase)
            || string.Equals(candidate.Old?.Path, path, StringComparison.OrdinalIgnoreCase)
            || string.Equals(candidate.New?.Path, path, StringComparison.OrdinalIgnoreCase));
        return change?.Path ?? path;
    }

    private async Task EnsureSelectedAssemblyTypesAsync(CancellationToken ct)
    {
        if (string.IsNullOrEmpty(Type)
            || _treeDiff is null
            || _loadedTypeChanges.ContainsKey(SelectedTreePath)
            || _loadingTypePaths.ContainsKey(SelectedTreePath))
        {
            return;
        }

        var selectedChange = _treeDiff.Changes.FirstOrDefault(change =>
            string.Equals(change.Path, SelectedTreePath, StringComparison.OrdinalIgnoreCase));
        var entry = selectedChange?.New ?? selectedChange?.Old;
        if (selectedChange is null || entry?.Kind != FileKind.Assembly)
        {
            return;
        }

        var selectedAssembly = _tree is null
            ? null
            : FileTreeBuilder.FindFileNode(_tree, SelectedTreePath);
        selectedAssembly ??= new FileTreeNode(
            System.IO.Path.GetFileName(SelectedTreePath),
            SelectedTreePath,
            IsDirectory: false)
        {
            Entry = entry,
            Change = selectedChange,
        };
        selectedAssembly.IsExpanded = true;
        _expandedTypePaths.Add(SelectedTreePath);
        await LoadAssemblyTypesAsync(selectedAssembly, ct);
    }

    private Task OnAssemblyExpand(FileTreeNode node)
        => LoadAssemblyTypesAsync(node, CurrentCancellationToken);

    private void OnAssemblyToggle(FileTreeNode node)
    {
        if (node.IsExpanded)
        {
            _expandedTypePaths.Add(node.FullPath);
        }
        else
        {
            _expandedTypePaths.Remove(node.FullPath);
        }
    }

    private async Task LoadAssemblyTypesAsync(FileTreeNode node, CancellationToken ct)
    {
        if (!node.IsAssembly || node.Change is null
            || node.TypeLoadState is not (AssemblyTypeLoadState.NotLoaded or AssemblyTypeLoadState.Failed))
        {
            return;
        }

        var path = node.FullPath;
        _failedTypeLoads.Remove(path);
        var loadId = ++_nextTypeLoadId;
        using var analysisCts = new CancellationTokenSource();
        var analysisCt = analysisCts.Token;
        _loadingTypePaths[path] = loadId;
        _typeLoadTokens[path] = (loadId, analysisCts);
        node.TypeLoadState = AssemblyTypeLoadState.Loading;
        await InvokeAsync(StateHasChanged);
        try
        {
            var listed = await Comparisons.LoadAssemblyTypeListAsync(
                Id,
                V1,
                V2,
                node.Change,
                analysisCt);
            if (analysisCt.IsCancellationRequested)
            {
                if (!CompleteTypeLoad(path, loadId)) return;
                SetCurrentTypeLoadState(path, AssemblyTypeLoadState.NotLoaded);
                return;
            }
            if (!listed.IsSuccess)
            {
                if (!CompleteTypeLoad(path, loadId)) return;
                _failedTypeLoads[path] = listed.Error ?? "Failed to load assembly types.";
                RebuildTree();
                return;
            }

            _listedTypeChanges[path] = listed.Changes!;
            RebuildTree();
            await InvokeAsync(StateHasChanged);

            var result = await Comparisons.LoadAssemblyTypesAsync(
                Id,
                V1,
                V2,
                node.Change,
                analysisCt);
            if (analysisCt.IsCancellationRequested)
            {
                if (!CompleteTypeLoad(path, loadId)) return;
                _listedTypeChanges.Remove(path);
                SetCurrentTypeLoadState(path, AssemblyTypeLoadState.NotLoaded);
                return;
            }
            if (!CompleteTypeLoad(path, loadId)) return;
            if (!result.IsSuccess)
            {
                _failedTypeLoads[path] = result.Error ?? "Failed to filter unchanged types.";
                RebuildTree();
                return;
            }

            _listedTypeChanges.Remove(path);
            _failedTypeLoads.Remove(path);
            _loadedTypeChanges[path] = result.Changes!;
            RebuildTree();
        }
        catch (OperationCanceledException) when (analysisCt.IsCancellationRequested)
        {
            if (!CompleteTypeLoad(path, loadId)) return;
            _listedTypeChanges.Remove(path);
            RebuildTree();
            SetCurrentTypeLoadState(path, AssemblyTypeLoadState.NotLoaded);
            return;
        }
        catch (Exception ex) when (ex is HttpRequestException or IOException or ArgumentException)
        {
            if (!CompleteTypeLoad(path, loadId)) return;
            _failedTypeLoads[path] = $"Failed to load types: {ex.Message}";
            RebuildTree();
        }
        catch (Exception ex) when (!analysisCt.IsCancellationRequested)
        {
            if (!CompleteTypeLoad(path, loadId)) return;
            _failedTypeLoads[path] = $"Failed to load types: {ex.Message}";
            RebuildTree();
        }
        await InvokeAsync(StateHasChanged);
    }

    private bool CompleteTypeLoad(string path, long loadId)
    {
        if (!_loadingTypePaths.TryGetValue(path, out var current)
            || current != loadId)
        {
            return false;
        }
        _loadingTypePaths.Remove(path);
        if (_typeLoadTokens.TryGetValue(path, out var token)
            && token.Id == loadId)
        {
            _typeLoadTokens.Remove(path);
        }
        return true;
    }

    private void CancelTypeLoads()
    {
        foreach (var (_, cts) in _typeLoadTokens.Values)
        {
            cts.Cancel();
        }
        _typeLoadTokens.Clear();
        _loadingTypePaths.Clear();
        _listedTypeChanges.Clear();
    }

    private FileTreeNode? SetCurrentTypeLoadState(
        string path,
        AssemblyTypeLoadState state)
    {
        var current = _tree is null
            ? null
            : FileTreeBuilder.FindFileNode(_tree, path);
        if (current is not null)
        {
            current.TypeLoadState = state;
        }
        return current;
    }

    public override void Dispose()
    {
        CancelTypeLoads();
        base.Dispose();
    }

    private void OnFileClick(FileTreeNode node)
    {
        if (node.IsDirectory) return;
        var p = Uri.EscapeDataString(node.FullPath);
        var url = $"/{Uri.EscapeDataString(Id)}/{Uri.EscapeDataString(V1)}/{Uri.EscapeDataString(V2)}/file?path={p}";
        if (!string.IsNullOrEmpty(node.TypeFullName))
        {
            url += $"&type={Uri.EscapeDataString(node.TypeFullName)}";
        }
        Nav.NavigateTo(url);
    }
}
