@page "/local/{hash}"
@using NuGetDiff.Core.Decompilation
@using NuGetDiff.Core.Models
@using NuGetDiff.Core.Packages
@using NuGetDiff.Web.Components
@using NuGetDiff.Web.Services
@inherits CancellablePageBase
@inject PackageAnalysisService Analysis
@inject BusyState Busy
@inject NavigationManager Nav

<PageTitle>@(_contents?.Metadata.Id ?? "Local package")</PageTitle>

<nav class="breadcrumb">
    <a href="/">Home</a> / <strong>local upload</strong>
</nav>

@if (_error is not null)
{
    <p class="error">@_error</p>
    <p>The <code>/local/{hash}</code> URL only resolves on a machine that has the matching <code>.nupkg</code> uploaded. Drop the file again from the home page.</p>
}
else if (_contents is null)
{
    <p>Loading uploaded package…</p>
}
else
{
    <h1>@_contents.Metadata.Id <small class="version">@_contents.Metadata.Version</small> <span class="muted">(local)</span></h1>
    @if (!string.IsNullOrWhiteSpace(_contents.Metadata.Description))
    {
        <p class="description">@_contents.Metadata.Description</p>
    }

    <h2>Contents (@_contents.Files.Count files)</h2>
    @if (_tree is not null)
    {
        <FileTree Node="_tree" OnFileClick="OnFileClick"
                  OnAssemblyExpand="OnAssemblyExpand" />
    }
}

@code {
    [Parameter] public string Hash { get; set; } = string.Empty;

    private PackageContents? _contents;
    private FileTreeNode? _tree;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        var ct = BeginLoad();
        _contents = null;
        _tree = null;
        _error = null;
        StateHasChanged();
        using var _ = Busy.Begin("Loading uploaded package…");
        try
        {
            var result = await Analysis.LoadLocalAsync(Hash, ct);
            if (ct.IsCancellationRequested) return;
            if (!result.IsSuccess)
            {
                _error = result.Error;
                return;
            }

            _tree = FileTreeBuilder.Build(result.Contents!.Files);
            _contents = result.Contents;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            return;
        }
        catch (Exception ex)
        {
            if (ct.IsCancellationRequested) return;
            _error = $"Failed to load package: {ex.Message}";
        }
    }

    private async Task OnAssemblyExpand(FileTreeNode node)
    {
        var ct = CurrentCancellationToken;
        if (!node.IsAssembly || node.TypeLoadState != AssemblyTypeLoadState.NotLoaded)
        {
            return;
        }

        node.TypeLoadState = AssemblyTypeLoadState.Loading;
        await InvokeAsync(StateHasChanged);
        try
        {
            var result = await Analysis.LoadLocalTypesAsync(
                Hash,
                node.FullPath,
                ct);
            if (ct.IsCancellationRequested)
            {
                node.TypeLoadState = AssemblyTypeLoadState.NotLoaded;
                return;
            }
            if (!result.IsSuccess)
            {
                node.TypeLoadState = AssemblyTypeLoadState.Failed;
                node.TypeLoadError = result.Error!.Message;
            }
            else
            {
                FileTreeBuilder.PopulateAssemblyTypes(node, result.Types!);
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            node.TypeLoadState = AssemblyTypeLoadState.NotLoaded;
            return;
        }
        catch (Exception ex) when (ex is IOException or ArgumentException)
        {
            node.TypeLoadState = AssemblyTypeLoadState.Failed;
            node.TypeLoadError = $"Failed to load types: {ex.Message}";
        }
        await InvokeAsync(StateHasChanged);
    }

    private void OnFileClick(FileTreeNode node)
    {
        if (node.IsDirectory) return;
        var path = Uri.EscapeDataString(node.FullPath);
        var url = $"/local/{Hash}/file?path={path}";
        if (!string.IsNullOrEmpty(node.TypeFullName))
        {
            url += $"&type={Uri.EscapeDataString(node.TypeFullName)}";
        }
        Nav.NavigateTo(url);
    }
}
