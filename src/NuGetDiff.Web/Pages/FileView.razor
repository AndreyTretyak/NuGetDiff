@page "/{id}/{version}/file"
@using NuGetDiff.Core.Decompilation
@using NuGetDiff.Core.Models
@using NuGetDiff.Core.Packages
@using NuGetDiff.Web.Components
@using NuGetDiff.Web.Services
@using Microsoft.JSInterop
@inherits CancellablePageBase
@inject PackageResolver Resolver
@inject BusyState Busy
@inject MarkdownRenderer Markdown
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@Path — @Id @Version</PageTitle>

<nav class="breadcrumb">
    <a href="/">Home</a> /
    <a href="/@Uri.EscapeDataString(Id)">@Id</a> /
    <a href="/@Uri.EscapeDataString(Id)/@Uri.EscapeDataString(Version)">@Version</a> /
    <strong>@Path</strong>
</nav>

<div class="file-layout">
    <aside class="file-sidebar">
        <h2 class="sidebar-title">Package contents</h2>
        @if (_tree is not null)
        {
            <FileTree Node="_tree" OnFileClick="OnFileClick" SelectedPath="@Path" />
        }
        else if (_error is not null)
        {
            <p class="muted">No tree available.</p>
        }
        else
        {
            <p class="muted">Loading tree…</p>
        }
    </aside>

    <section class="file-content">
        <h1>@System.IO.Path.GetFileName(Path)</h1>
        <p class="muted">@Path · @Id @Version</p>

        @if (_error is not null)
        {
            <p class="error">@_error</p>
        }
        else if (_loading)
        {
            <p>Loading…</p>
        }
        else if (_kind == FileKind.Markdown && _text is not null)
        {
            <article class="markdown-body">@((MarkupString)Markdown.ToHtml(_text))</article>
        }
        else if ((_kind == FileKind.Text || _kind == FileKind.Markdown) && _text is not null)
        {
            <pre class="code-view"><code class="@CodeLanguageClass">@_text</code></pre>
        }
        else if (_kind == FileKind.Assembly)
        {
            @if (_decompilation is not null)
            {
                @if (_decompilation.Warnings.Count > 0)
                {
                    <details class="warnings">
                        <summary>@_decompilation.Warnings.Count warnings</summary>
                        <ul>@foreach (var w in _decompilation.Warnings) { <li>@w</li> }</ul>
                    </details>
                }
                <pre class="code-view"><code class="language-csharp">@_decompilation.CSharp</code></pre>
            }
            else if (_decompError is not null)
            {
                <p class="error">@_decompError.Message @(_decompError.Detail is null ? "" : "— " + _decompError.Detail)</p>
            }
        }
        else if (_kind == FileKind.Binary)
        {
            <p class="muted">Binary file. @_lengthDescription</p>
        }
    </section>
</div>

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    [Parameter] public string Version { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "path")] public string Path { get; set; } = string.Empty;

    private bool _loading = true;
    private string? _error;
    private FileKind _kind = FileKind.Unknown;
    private string? _text;
    private DecompilationResult? _decompilation;
    private DecompilationError? _decompError;
    private string? _lengthDescription;
    private FileTreeNode? _tree;
    private bool _shouldHighlight;

    // Cap the size of content we hand to Prism so very large generated files
    // (e.g. 1+ MB minified bundles) don't freeze the UI.
    private const int MaxHighlightChars = 500_000;

    private string CodeLanguageClass
    {
        get
        {
            var lang = LanguageDetector.FromPath(Path);
            return lang is null ? string.Empty : $"language-{lang}";
        }
    }

    // Cache the contents tree per (id, version) so re-navigating between files
    // in the same package doesn't redownload and reparse it every time.
    private string _treeKey = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        var ct = BeginLoad();
        var key = $"{Id}|{Version}";
        var keyChanged = !string.Equals(_treeKey, key, StringComparison.OrdinalIgnoreCase);
        if (keyChanged)
        {
            _tree = null;
        }
        Reset();
        StateHasChanged();
        if (string.IsNullOrEmpty(Path))
        {
            _error = "No file path provided. Add ?path=lib/...";
            _loading = false;
            return;
        }

        using var _ = Busy.Begin($"Loading {Path}…");
        try
        {
            await using var stream = await Resolver.OpenOnlineAsync(Id, Version, ct);
            if (ct.IsCancellationRequested) return;
            if (stream is null) { _error = $"Could not find {Id} {Version}."; _loading = false; return; }
            using var reader = new PackageReader(stream);

            if (keyChanged || _tree is null)
            {
                _tree = FileTreeBuilder.Build(reader.Files);
                _treeKey = key;
                StateHasChanged();
            }

            if (!reader.ContainsFile(Path))
            {
                _error = $"File '{Path}' is not in this package.";
                _loading = false;
                return;
            }

            var entry = reader.Files.First(f => string.Equals(f.Path, Path, StringComparison.OrdinalIgnoreCase));
            _kind = entry.Kind;
            _lengthDescription = $"{entry.Length} bytes";

            if (_kind == FileKind.Text || _kind == FileKind.Markdown)
            {
                var bytes = reader.ReadFileBytes(Path);
                _text = DecodeText(bytes);
            }
            else if (_kind == FileKind.Assembly)
            {
                Busy.Update($"Decompiling {Path}…");
                await Task.Yield();
                if (ct.IsCancellationRequested) return;
                var result = new Decompiler().DecompileFromPackage(reader, Path);
                if (ct.IsCancellationRequested) return;
                if (result.IsOk) _decompilation = result.Ok;
                else _decompError = result.Err;
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            return;
        }
        catch (Exception ex)
        {
            if (ct.IsCancellationRequested) return;
            _error = $"Failed to read file: {ex.Message}";
        }
        finally
        {
            if (!ct.IsCancellationRequested)
            {
                _loading = false;
                var contentLength = _text?.Length ?? _decompilation?.CSharp?.Length ?? 0;
                var hasLanguage = !string.IsNullOrEmpty(LanguageDetector.FromPath(Path));
                _shouldHighlight =
                    contentLength > 0
                    && contentLength <= MaxHighlightChars
                    && (
                        (_kind == FileKind.Markdown && _text is not null)                          // README code fences
                        || (_kind == FileKind.Text && _text is not null && hasLanguage)             // .cs/.json/etc.
                        || (_kind == FileKind.Assembly && _decompilation is not null)               // decompiled C#
                    );
            }
        }
    }

    // Re-highlight after every render: Razor may rewrite <code>'s text content
    // on a re-render that re-evaluates the markup, which would discard Prism's
    // spans. Prism.highlightAllUnder is idempotent because it tokenises from
    // textContent.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldHighlight)
        {
            try
            {
                await JS.InvokeVoidAsync("nuGetDiff.highlightAll", ".file-content");
            }
            catch (JSException)
            {
                // Prism not loaded — non-fatal.
            }
            catch (TaskCanceledException)
            {
                // Component disposed mid-call — safe to ignore.
            }
        }
    }

    private void Reset()
    {
        _loading = true;
        _error = null;
        _kind = FileKind.Unknown;
        _text = null;
        _decompilation = null;
        _decompError = null;
        _lengthDescription = null;
        _shouldHighlight = false;
    }

    private void OnFileClick(FileTreeNode node)
    {
        if (node.IsDirectory) return;
        var p = Uri.EscapeDataString(node.FullPath);
        Nav.NavigateTo($"/{Uri.EscapeDataString(Id)}/{Uri.EscapeDataString(Version)}/file?path={p}");
    }

    private static string DecodeText(byte[] bytes)
    {
        if (bytes.Length >= 3 && bytes[0] == 0xEF && bytes[1] == 0xBB && bytes[2] == 0xBF)
            return System.Text.Encoding.UTF8.GetString(bytes, 3, bytes.Length - 3);
        if (bytes.Length >= 2 && bytes[0] == 0xFF && bytes[1] == 0xFE)
            return System.Text.Encoding.Unicode.GetString(bytes, 2, bytes.Length - 2);
        if (bytes.Length >= 2 && bytes[0] == 0xFE && bytes[1] == 0xFF)
            return System.Text.Encoding.BigEndianUnicode.GetString(bytes, 2, bytes.Length - 2);
        try
        {
            var enc = new System.Text.UTF8Encoding(encoderShouldEmitUTF8Identifier: false, throwOnInvalidBytes: true);
            return enc.GetString(bytes);
        }
        catch (System.Text.DecoderFallbackException)
        {
            return System.Text.Encoding.Latin1.GetString(bytes);
        }
    }
}
