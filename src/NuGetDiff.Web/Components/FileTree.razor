@using NuGetDiff.Core.Models
@using NuGetDiff.Web.Services
@inject NavigationManager Nav

<ul class="file-tree @(Root ? "file-tree-root" : "")">
    @foreach (var child in Node.Children)
    {
        <li class="file-tree-node @(child.IsDirectory ? "is-dir" : (child.IsAssemblyContainer ? "is-asm" : "is-file"))">
            @if (child.IsDirectory)
            {
                <details open>
                    <summary><span class="icon">📁</span> @child.Name</summary>
                    <FileTree Node="child" Root="false" OnFileClick="OnFileClick"
                              OnAssemblyExpand="OnAssemblyExpand"
                              OnAssemblyToggle="OnAssemblyToggle"
                              SelectedPath="@SelectedPath" SelectedType="@SelectedType" />
                </details>
            }
            else if (child.IsAssemblyContainer)
            {
                @* Assembly names and disclosure controls both toggle the same
                   lazy type list, avoiding an expensive whole-module view. *@
                <details open="@child.IsExpanded">
                    <summary @onclick="@(() => ToggleAssembly(child))"
                             @onclick:preventDefault="true">
                        <a class="file-link asm-summary @ChangeClass(child) @(IsSelected(child) ? "selected" : string.Empty)"
                           href="javascript:void(0)"
                           @onclick:stopPropagation="true"
                           @onclick:preventDefault="true"
                           @onclick="@(() => ToggleAssembly(child))">
                            <span class="icon">@KindIcon(child)</span>
                            <span class="name">@child.Name</span>
                            @if (child.Change is { Kind: var ack } && ack != FileChangeKind.Unchanged)
                            {
                                <span class="badge badge-@ack.ToString().ToLowerInvariant()">@BadgeText(ack)</span>
                            }
                        </a>
                        <button type="button"
                               class="assembly-open"
                               title="Open whole assembly"
                               @onclick:stopPropagation="true"
                               @onclick:preventDefault="true"
                               @onclick="@(() => OnFileClick.InvokeAsync(child))">
                            Open
                        </button>
                    </summary>
                    @if (child.TypeLoadState == AssemblyTypeLoadState.Loading)
                    {
                        <p class="tree-status muted">Loading types…</p>
                    }
                    else
                    {
                        @if (child.TypeLoadState == AssemblyTypeLoadState.Analyzing)
                        {
                            <p class="tree-status muted">Filtering unchanged types…</p>
                        }
                        else if (child.TypeLoadState == AssemblyTypeLoadState.Failed)
                        {
                            <p class="tree-status error">@child.TypeLoadError</p>
                        }
                        else if (child.TypeLoadState == AssemblyTypeLoadState.Loaded && child.Children.Count == 0)
                        {
                            <p class="tree-status muted">No matching types.</p>
                        }
                        @if (child.Children.Count > 0)
                        {
                            <FileTree Node="child" Root="false" OnFileClick="OnFileClick"
                                      OnAssemblyExpand="OnAssemblyExpand"
                                      OnAssemblyToggle="OnAssemblyToggle"
                                      SelectedPath="@SelectedPath" SelectedType="@SelectedType" />
                        }
                    }
                </details>
            }
            else
            {
                <a class="file-link @(child.TypeFullName is not null ? "is-type" : string.Empty) @ChangeClass(child) @(IsSelected(child) ? "selected" : string.Empty)"
                   href="javascript:void(0)"
                   @onclick="@(() => OnFileClick.InvokeAsync(child))">
                    <span class="icon">@KindIcon(child)</span>
                    <span class="name">@child.Name</span>
                    @if (child.Change is { Kind: var ck } && ck != FileChangeKind.Unchanged)
                    {
                        <span class="badge badge-@ck.ToString().ToLowerInvariant()">@BadgeText(ck)</span>
                    }
                </a>
            }
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired] public FileTreeNode Node { get; set; } = default!;
    [Parameter] public bool Root { get; set; } = true;
    [Parameter] public EventCallback<FileTreeNode> OnFileClick { get; set; }
    [Parameter] public EventCallback<FileTreeNode> OnAssemblyExpand { get; set; }
    [Parameter] public EventCallback<FileTreeNode> OnAssemblyToggle { get; set; }
    [Parameter] public string? SelectedPath { get; set; }
    [Parameter] public string? SelectedType { get; set; }

    private bool IsSelected(FileTreeNode node)
    {
        if (node.IsDirectory) return false;
        if (string.IsNullOrEmpty(SelectedPath)) return false;
        if (!string.Equals(node.FullPath, SelectedPath, StringComparison.OrdinalIgnoreCase)) return false;

        // Path matches. The node is selected iff its TypeFullName matches the
        // current SelectedType (both null = whole-file view; both equal = the
        // exact type the user is looking at).
        var nodeType = node.TypeFullName ?? string.Empty;
        var selType = SelectedType ?? string.Empty;
        return string.Equals(nodeType, selType, StringComparison.Ordinal);
    }

    private async Task ToggleAssembly(FileTreeNode node)
    {
        node.IsExpanded = !node.IsExpanded;
        await OnAssemblyToggle.InvokeAsync(node);
        if (node.IsExpanded
            && node.TypeLoadState is AssemblyTypeLoadState.NotLoaded or AssemblyTypeLoadState.Failed)
        {
            await OnAssemblyExpand.InvokeAsync(node);
        }
    }

    private static string KindIcon(FileTreeNode node)
    {
        if (node.TypeFullName is not null) return "🔹";
        return node.Entry?.Kind switch
        {
            FileKind.Markdown => "📝",
            FileKind.Text => "📄",
            FileKind.Assembly => "🧩",
            FileKind.Binary => "📦",
            _ => "❔",
        };
    }

    private static string ChangeClass(FileTreeNode node) => node.Change?.Kind switch
    {
        FileChangeKind.Added => "change-added",
        FileChangeKind.Removed => "change-removed",
        FileChangeKind.Modified => "change-modified",
        FileChangeKind.Renamed => "change-renamed",
        _ => string.Empty,
    };

    private static string BadgeText(FileChangeKind kind) => kind switch
    {
        FileChangeKind.Added => "+",
        FileChangeKind.Removed => "−",
        FileChangeKind.Modified => "~",
        FileChangeKind.Renamed => "⇄",
        _ => string.Empty,
    };
}
