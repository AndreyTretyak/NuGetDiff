@page "/"

<PageTitle>NuGetDiff</PageTitle>

<section class="hero" aria-labelledby="hero-title">
    <p class="eyebrow">NuGet package comparison</p>
    <h1 id="hero-title">See what changed between package versions.</h1>
    <p class="lead">
        NuGetDiff is a focused workspace for understanding package changes without
        the noise of a full development environment.
    </p>
    <div class="shell-status" role="status">
        <span class="status-dot" aria-hidden="true"></span>
        <span>
            <strong>Application shell ready</strong>
            <span>The package comparison workflow is the next product capability.</span>
        </span>
    </div>
</section>
